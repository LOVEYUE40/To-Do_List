# 统一按 LF 入库，避免 Windows 与 CI 之间的 CRLF 造成整文件级 diff 噪声
* text=auto eol=lf

# Windows 脚本保持 CRLF，否则部分工具会解析异常
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# 二进制资源不做行尾转换，也不参与文本 diff
*.ico binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.icns binary
*.exe binary
*.dll binary
*.zip binary
*.7z binary
