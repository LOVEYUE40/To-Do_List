registry=https://registry.npmmirror.com
fund=false
audit=false

# Electron / electron-builder 的二进制镜像不走 npm 配置项：
# electron_mirror 与 electron_builder_binaries_mirror 都不是合法的 npm key，
# 写在这里只会让每条 npm 命令都打印 "Unknown project config" 警告。
# 需要镜像时请用环境变量（CI 的 release.yml 就是这么做的）：
#   ELECTRON_MIRROR=https://npmmirror.com/mirrors/electron/
#   ELECTRON_BUILDER_BINARIES_MIRROR=https://npmmirror.com/mirrors/electron-builder-binaries/
